# Скопируйте в .env и заполните значения. Файл .env в репозиторий не коммитится.

# Базовый URL для Playwright (baseURL); без пробела после =
BASE_URL=https://fstravel.com

# Точки входа в сценарии бронирования (по умолчанию совпадают с продом — см. config/bookingUrls.js)
BOOKING_EXCURSIONS_URL=https://fstravel.com/searchexcursions
BOOKING_AIRPORT_SERVICES_URL=https://fstravel.com/searchairportservices
BOOKING_YACHTS_URL=https://fstravel.com/searchyachtrent
BOOKING_CERTIFICATE_URL=https://fstravel.com/certificates
BOOKING_HOTEL_SERVICES_URL=https://fstravel.com/searchhotelservices

URL=https://testit.fstravel.com
# Токен пользователя, от чей учетки будет формироваться ран и запускаться тесты.
USER_PRIVATE_TOKEN=
# Id проекта в TestIT
PROJECT_ID=
# Id конфигурации в TestIT
CONFIGURATION_ID=
# Название ран в TestIT
TEST_RUN_NAME=
# Режим адаптера (2 - TestIT)
ADAPTER_MODE=2
# Режим адаптера (2 - TestIT)
TMS_ADAPTER_MODE=2
