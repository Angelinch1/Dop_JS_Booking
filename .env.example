# Базовый URL для Playwright (baseURL)
BASE_URL=https://fstravel.com

# Вход в корзину (pages/AllPages.js — authInBag / authInBag2; тест tests/basket-auth.spec.js)
BASKET_TEST_EMAIL=
BASKET_TEST_PASSWORD=
# Относительный путь или полный URL для входа через шапку (authInBag2). По умолчанию главная: /
# BASKET_AUTH_ENTRY_URL=/

# Полная запись видео и trace для каждого теста (1 или true). По умолчанию запись только при первом ретрае после падения.
# Видео и trace лежат в test-results/; HTML-отчёт: npm run report; trace: npx playwright show-trace test-results/.../trace.zip
PLAYWRIGHT_RECORD_ALL=
# Тонкая настройка (перекрывает значение по умолчанию от PLAYWRIGHT_RECORD_ALL): on | off | on-first-retry | retain-on-failure
# PLAYWRIGHT_TRACE=on
# PLAYWRIGHT_VIDEO=on

# Точки входа в сценарии бронирования (по умолчанию совпадают с продом — см. config/bookingUrls.js)
BOOKING_EXCURSIONS_URL=https://fstravel.com/searchexcursions
BOOKING_AIRPORT_SERVICES_URL=https://fstravel.com/searchairportservices
BOOKING_YACHTS_URL=https://fstravel.com/searchyachtrent
BOOKING_CERTIFICATE_URL=https://fstravel.com/certificates
BOOKING_HOTEL_SERVICES_URL=https://fstravel.com/searchhotelservices

URL=https://testit.fstravel.com
# Токен пользователя, от чей учетки будет формироваться ран и запускаться тесты.
USER_PRIVATE_TOKEN=
# Id проекта в TestIT
PROJECT_ID=
# Id конфигурации в TestIT
CONFIGURATION_ID=
# Название ран в TestIT
TEST_RUN_NAME=
# Режим адаптера (2 - TestIT)
ADAPTER_MODE=2
# Режим адаптера (2 - TestIT)
TMS_ADAPTER_MODE=2
